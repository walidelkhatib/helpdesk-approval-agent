# Copy to .env.local for local development. Never commit .env.local.

# Vercel AI Gateway key (Vercel dashboard → AI Gateway → API Keys).
# Not needed on Vercel deployments: there the app authenticates with OIDC automatically.
# Alternative for local dev: `vercel link` then `vercel env pull` to get a short-lived OIDC token.
AI_GATEWAY_API_KEY=

# Secret used to sign approval requests so the browser can't forge an approval.
# Generate with: openssl rand -base64 32
TOOL_APPROVAL_SECRET=

# Optional: any AI Gateway model ID. Defaults to openai/gpt-5-mini (free tier).
# Claude models need paid AI Gateway credits.
# AI_MODEL=anthropic/claude-sonnet-5.5
